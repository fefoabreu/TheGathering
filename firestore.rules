rules_version = '2';

// ──────────────────────────────────────────────────────────────
//  TheGathering · Firestore Security Rules
// ──────────────────────────────────────────────────────────────
//  The public guest site reads the published Garopaba Guide and the
//  published house manual without signing in to anything meaningful.
//  Everything else — bookings, projects, lock codes, vendor payment
//  details — requires an OWNER session, which means Google.
//
//  See the isOwner() note below: that distinction is the whole point
//  of this file. config/access stays reserved and locked so tightening
//  further to a UID allowlist is a data change, not a rules rewrite.
// ──────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    /*  ANONYMOUS IS NOT AN OWNER.
     *
     *  This used to be signedIn(), meaning `request.auth != null`, and the
     *  intent was "has been through the @tgs gate". But that gate signs in
     *  ANONYMOUSLY — and so does every visitor to the public guest site,
     *  because Sisay needs a Firebase token to reach her Worker. One auth
     *  class for both, so the rules could not tell them apart: an anonymous
     *  token minted by simply loading fefoabreu.me/TheGathering/ could read
     *  gathering/secrets (lock codes, WiFi, vendor payment details) and
     *  gathering/bookings (guest names, origins, travel details). Verified
     *  against the live database on 2026-09-09, before this change.
     *
     *  Owners sign in with Google, so their token carries a sign_in_provider
     *  that is not 'anonymous'. That is the line, and the client cannot forge
     *  it — Firebase stamps the provider into the token itself.
     *
     *  Consequence, and it is intended: the @tgs password path can only ever
     *  mint an anonymous session, so it no longer opens the portal. Google
     *  sign-in on the house account is the way in.
     */
    function isOwner() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /gathering/{doc} {
      // The three documents the public guest site renders, and only those.
      // 'guide' is the Garopaba deck; 'houseGuide' is the published manual;
      // 'inventoryGuest' is the amenities projection Sisay answers from.
      //
      // inventoryGuest is DERIVED, never the real thing. The inventory itself
      // lives in /inventory below and is owners-only: it carries conditions,
      // damage, the bar bottles, owners' storage and the pendências Estar
      // recorded. The portal's publish step writes a projection that keeps
      // only guestFacing items and DROPS condition, notes, photoRef and the
      // pendência flags — dropped, not hidden, because anything in this doc
      // is world-readable by design. Filtering in Sisay's browser would mean
      // shipping the whole inventory to every guest and trusting the filter.
      allow read: if doc == 'guide' || doc == 'houseGuide' || doc == 'inventoryGuest';

      // Everything else, and every write anywhere, is owners-only.
      allow read, write: if isOwner();
    }

    // Anexo II — the Estar photographic inventory, one document per ambiente.
    // Owners-only, in full: item conditions are the baseline Estar measures
    // damage against, and a public list of what is in the house, brands and
    // all, tied to a published address, is a shopping list.
    match /inventory/{doc} {
      allow read, write: if isOwner();
    }

    // The Chronicle and agent chat history. Collections rather than
    // documents because both grow over time and want ordering.
    match /decisions/{id} {
      allow read, write: if isOwner();
    }
    match /agentSessions/{id} {
      allow read, write: if isOwner();
      match /messages/{msg} {
        allow read, write: if isOwner();
      }
    }

    // The allowlist itself is console-only. Never readable by a client:
    // rules `get()` runs server-side and is not subject to these rules.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Nothing else in the database is reachable from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
