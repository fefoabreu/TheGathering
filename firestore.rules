rules_version = '2';

// ──────────────────────────────────────────────────────────────
//  TheGathering · Firestore Security Rules
// ──────────────────────────────────────────────────────────────
//  The guest site reads the published Garopaba Guide without signing
//  in. Everything else — bookings, projects, door codes, vendor
//  payment details — requires an owner session.
//
//  Access control is deliberately light at this stage — see the
//  signedIn() note below. config/access stays reserved and locked
//  so tightening to a UID allowlist later is a data change, not a
//  rules rewrite.
// ──────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Owner decision (Aug 12): the @tgs gate is the only access control for
    // now — inside the portal everyone sees everything, as they always did in
    // the shared Google Doc. The portal signs in anonymously so Firestore has
    // a session; that keeps the data out of reach of unauthenticated REST
    // calls (no drive-by reads or wipes) without adding any login friction.
    //
    // To tighten later, swap this for the UID allowlist — config/access is
    // already reserved below and rules can read it without a redeploy:
    //   request.auth.uid in get(/databases/$(database)/documents/config/access).data.uids
    function signedIn() {
      return request.auth != null;
    }

    match /gathering/{doc} {
      // The published guide is what the guest booster pack renders.
      allow read: if doc == 'guide';

      // Everything else, and every write anywhere, is owners-only.
      allow read, write: if signedIn();
    }

    // The allowlist itself is console-only. Never readable by a client:
    // rules `get()` runs server-side and is not subject to these rules,
    // so isOwner() still works.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Nothing else in the database is reachable from the client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
